#!/usr/bin/env bash
set -Eeuo pipefail

: "${RESTIC_FROM_REPOSITORY:?Local Restic repository is not configured}"
: "${RESTIC_REPOSITORY:?R2 repository is not configured}"
: "${RESTIC_PASSWORD_FILE:?R2 repository password file is not configured}"
: "${RESTIC_FROM_PASSWORD_FILE:?Local repository password file is not configured}"
: "${AWS_ACCESS_KEY_ID:?R2 access key is not configured}"
: "${AWS_SECRET_ACCESS_KEY:?R2 secret key is not configured}"
: "${AWS_DEFAULT_REGION:?S3 region is not configured}"

if [[ ! -f "$RESTIC_FROM_REPOSITORY/config" ]]; then
  printf 'ERROR: Local Restic repository is unavailable or uninitialized: %s\n' \
    "$RESTIC_FROM_REPOSITORY" >&2
  exit 1
fi

for password_file in \
  "$RESTIC_PASSWORD_FILE" \
  "$RESTIC_FROM_PASSWORD_FILE"
do
  if [[ ! -r "$password_file" ]]; then
    printf 'ERROR: Required Restic password file is unreadable: %s\n' \
      "$password_file" >&2
    exit 1
  fi
done

printf '[%s] Starting off-site Restic snapshot copy.\n' \
  "$(date '+%Y-%m-%d %H:%M:%S')"

restic \
  --repo "$RESTIC_REPOSITORY" \
  --password-file "$RESTIC_PASSWORD_FILE" \
  copy \
  --from-repo "$RESTIC_FROM_REPOSITORY" \
  --from-password-file "$RESTIC_FROM_PASSWORD_FILE" \
  --verbose

printf '[%s] Off-site snapshot copy completed successfully.\n' \
  "$(date '+%Y-%m-%d %H:%M:%S')"

retention_args=(
  --group-by host,tags
  --keep-daily 14
  --keep-weekly 8
  --keep-monthly 6
)

case "${RESTIC_OFFSITE_RETENTION_MODE:-dry-run}" in
  dry-run)
    printf 'Evaluating R2 retention policy in dry-run mode; no snapshots will be removed.\n'

    restic \
      --repo "$RESTIC_REPOSITORY" \
      --password-file "$RESTIC_PASSWORD_FILE" \
      forget "${retention_args[@]}" \
      --dry-run
    ;;

  enforce)
    printf 'Applying R2 retention policy and pruning unreferenced data.\n'

    restic \
      --repo "$RESTIC_REPOSITORY" \
      --password-file "$RESTIC_PASSWORD_FILE" \
      forget "${retention_args[@]}" \
      --prune
    ;;

  *)
    printf 'ERROR: Invalid RESTIC_OFFSITE_RETENTION_MODE: %s\n' \
      "$RESTIC_OFFSITE_RETENTION_MODE" >&2
    exit 2
    ;;
esac

printf '[%s] Off-site replication and retention processing completed.\n' \
  "$(date '+%Y-%m-%d %H:%M:%S')"
